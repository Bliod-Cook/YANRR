# The address everyone uses to reach YANRR, exactly as typed in the apps. The Android app needs https://.
YANRR_SERVER__PUBLIC_URL=https://rss.example.com
# At least 32 random characters, e.g. from `openssl rand -hex 32`
YANRR_AUTH__SECRET=
# Set to false once your accounts exist
YANRR_AUTH__REGISTRATION=true
# Runs Caddy for automatic HTTPS at the address above; remove if you have your own reverse proxy
COMPOSE_PROFILES=caddy
# The optional image proxy (see docs/self-hosting.md): uncomment, set the key like the secret above, and add
# image-proxy to the profiles, e.g. COMPOSE_PROFILES=caddy,image-proxy
# YANRR_IMAGE_PROXY__URL=https://rss.example.com/image-proxy
# YANRR_IMAGE_PROXY__KEY=
