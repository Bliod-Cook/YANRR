{
  "name": "@follow/shared",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "require": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./interface/*": {
      "types": "./src/interface/*.ts",
      "require": "./src/interface/*.ts",
      "import": "./src/interface/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@follow-app/client-sdk": "catalog:",
    "@folo-services/drizzle": "0.1.50",
    "@t3-oss/env-core": "0.13.11",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  }
}
