{
  "name": "@follow/monorepo",
  "type": "module",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.x",
      "onFail": "ignore"
    }
  },
  "description": "Self-hosted personal RSS reader",
  "author": "Bliod-Cook",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build:web": "turbo run Yanrr#build:web",
    "dedupe:locales": "eslint --fix locales/**",
    "depcheck": "npx depcheck --quiet",
    "dev:web": "pnpm --filter Yanrr dev:web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:app": "tsx scripts/generate-icons.ts",
    "icons:sync": "tsx scripts/svg-to-rn.ts && prettier --write apps/mobile/src/icons/**/*.tsx && eslint --fix apps/mobile/src/icons/**/*.tsx",
    "lint": "pnpm run lint:tsl && eslint",
    "lint:fix": "eslint --fix",
    "lint:tsl": "tsslint --project apps/*/tsconfig.json",
    "polyfill-optimize": "pnpx nolyfill install",
    "prepare": "simple-git-hooks",
    "reinstall": "rimraf --glob node_modules \"apps/**/node_modules\" \"packages/**/node_modules\" && pnpm install",
    "test": "cross-env CI=1 pnpm --recursive run test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@eslint/compat": "2.1.1",
    "@shockpkg/icon-encoder": "3.2.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsslint/cli": "3.1.4",
    "@tsslint/compat-eslint": "3.1.4",
    "@tsslint/config": "3.1.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "10.15.0",
    "eslint-config-hyoban": "7.0.3",
    "eslint-plugin-react-native": "5.0.0",
    "fast-glob": "3.3.3",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.4",
    "sharp": "0.35.5",
    "simple-git-hooks": "2.14.0",
    "svg-parser": "2.1.0",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "catalog:",
    "vite": "7.3.6",
    "vitest": "5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --ignore-unknown --write"
    ]
  }
}
